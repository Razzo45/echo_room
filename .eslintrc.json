{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    /**
     * The existing codebase uses `any` widely in API layers and legacy components.
     * Treat these as style issues, not build blockers.
     */
    "@typescript-eslint/no-explicit-any": "off",

    /**
     * Unused variables can be noisy in large handler signatures.
     * Keep as a warning so they show up in editors but do not fail `next build`.
     */
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],

    /**
     * React hooks exhaustive-deps is helpful but over‑strict for some data‑loading effects.
     * Keep it as a warning to avoid blocking builds.
     */
    "react-hooks/exhaustive-deps": "warn"
  }
}
